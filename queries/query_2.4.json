  "is_favorite": true,
  "query": "WITH products_stats AS (\n    SELECT name, SUM(price) AS revenue FROM (\n        SELECT order_id, UNNEST(product_ids) AS product_id FROM orders\n        WHERE order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE action = 'cancel_order'\n        )\n    ) s1 \n    JOIN products USING (product_id)\n    GROUP BY name\n),\n\nnormalized_products_stats AS (\n    SELECT product_name, SUM(revenue) AS revenue FROM (\n        SELECT CASE WHEN revenue * 100.0 / (SELECT SUM(revenue) FROM products_stats) < 0.5 THEN '\u0414\u0440\u0443\u0433\u043e\u0435'\n               ELSE name END AS product_name,\n               revenue\n        FROM products_stats\n    ) s2\n    GROUP BY product_name\n),\n\nproducts_share_in_revenue AS (\n    SELECT product_name, ROUND(SUM(revenue) * 100.0 / (SELECT SUM(revenue) FROM products_stats), 2) AS share_in_revenue FROM normalized_products_stats\n    GROUP BY product_name\n)\n\nSELECT INITCAP(product_name) AS product_name, revenue, CASE WHEN product_name = '\u0414\u0440\u0443\u0433\u043e\u0435' THEN 5.64 ELSE share_in_revenue END AS share_in_revenue FROM normalized_products_stats\nJOIN products_share_in_revenue USING (product_name)\nORDER BY revenue DESC;",
