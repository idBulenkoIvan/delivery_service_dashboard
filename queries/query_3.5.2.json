07, 9226, 9227, 9229, 9230, 9231, 9250, 9255, 9259, 9267, 9273, 9281, 9282, 9289, 9292, 9303, 9310, 9312, 9315, 9327, 9333, 9335, 9337, 9343, 9356, 9368, 9370, 9383, 9392, 9404, 9410, 9421, 9428, 9432, 9437, 9468, 9479, 9483, 9485, 9492, 9495, 9497, 9498, 9500, 9510, 9527, 9529, 9530, 9538, 9539, 9545, 9557, 9558, 9560, 9564, 9567, 9570, 9591, 9596, 9598, 9616, 9631, 9634, 9635, 9636, 9658, 9666, 9672, 9684, 9692, 9700, 9704, 9706, 9711, 9719, 9727, 9735, 9741, 9744, 9749, 9752, 9753, 9755, 9757, 9764, 9783, 9784, 9788, 9790, 9808, 9820, 9839, 9841, 9843, 9853, 9855, 9859, 9863, 9877, 9879, 9880, 9882, 9883, 9885, 9901, 9904, 9908, 9910, 9912, 9920, 9929, 9930, 9935, 9939, 9958, 9959, 9961, 9983, 10027, 10033, 10038, 10045, 10047, 10048, 10058, 10059, 10067, 10069, 10073, 10075, 10078, 10079, 10081, 10092, 10106, 10110, 10113, 10131)\r\n    ) s2\r\n    JOIN products USING (product_id)\r\n    GROUP BY date\r\n),\r\n \r\nsecond_campaign_arppu AS (\r\n    SELECT '\u041a\u0430\u043c\u043f\u0430\u043d\u0438\u044f \u2116 2' AS campaign_ads, \r\n           'Day ' || (ROW_NUMBER() OVER (ORDER BY date) - 1) AS day, \r\n           ROUND(SUM(daily_revenue) OVER (ORDER BY date ASC) * 1.0 / 234, 2) AS cumulative_arppu\r\n    FROM second_campaign_revenue\r\n )\r\n\r\nSELECT campaign_ads, day, cumulative_arppu, cac FROM second_campaign_arppu\r\n    JOIN second_campaign_cac USING (campaign_ads)\r\n\r\nORDER BY campaign_ads ASC, day ASC;\r\n\r\n",
