  "is_favorite": true,
  "query": "WITH active_users AS (\n    SELECT DATE(time) AS date, COUNT(DISTINCT user_id) AS active_users_cnt FROM user_actions\n    WHERE order_id NOT IN (\n        SELECT order_id FROM user_actions\n        WHERE action = 'cancel_order'\n    )\n    GROUP BY date\n),\n\nuser_stats AS (\n    SELECT date, COUNT(user_id) AS special_users_cnt FROM (\n        SELECT DATE(time) AS date, user_id, COUNT(DISTINCT order_id) AS orders_cnt FROM user_actions\n        WHERE order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE action = 'cancel_order'\n        )\n        GROUP BY date, user_id\n        HAVING COUNT(DISTINCT order_id) = 1\n    ) AS subquery\n    GROUP BY date\n)\n\nSELECT date, ROUND((special_users_cnt * 100.0 / active_users_cnt), 2) AS single_order_users_share,\n       ROUND(100 - (special_users_cnt * 100.0 / active_users_cnt), 2) AS several_orders_users_share\nFROM user_stats\n    JOIN active_users USING (date)\nORDER BY date;",
