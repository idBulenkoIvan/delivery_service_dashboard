  "is_favorite": true,
  "query": "WITH total_orders AS (\n    SELECT DATE(time) AS date, COUNT(DISTINCT order_id) AS orders_cnt FROM user_actions\n    WHERE order_id NOT IN (\n        SELECT order_id FROM user_actions\n        WHERE action = 'cancel_order'\n    )\n    GROUP BY date\n),\n\nfirst_orders AS (\n    SELECT date, COUNT(user_id) AS first_orders_cnt FROM (\n        SELECT DATE(MIN(time)) AS date, user_id FROM user_actions\n        WHERE order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE action = 'cancel_order'\n        )\n        GROUP BY user_id\n    ) AS subquery\n    GROUP BY date\n),\n\nnew_users_orders AS (\n    SELECT f.date, COALESCE(COUNT(order_id), 0) AS new_users_orders_cnt FROM (\n        SELECT DATE(MIN(time)) AS date, user_id FROM user_actions\n        GROUP BY user_id \n    ) f\n    LEFT JOIN (\n        SELECT DATE(time) AS date, user_id, order_id FROM user_actions\n        WHERE order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE action = 'cancel_order'\n        )\n    ) s\n    ON s.date = f.date AND s.user_id = f.user_id\n    GROUP BY f.date\n)\n\nSELECT date, orders_cnt AS orders, first_orders_cnt AS first_orders,\n       new_users_orders_cnt AS new_users_orders,\n       ROUND(first_orders_cnt * 100.0 / orders_cnt, 2) AS first_orders_share,\n       ROUND(new_users_orders_cnt * 100.0 / orders_cnt, 2) AS new_users_orders_share\nFROM total_orders\n    LEFT JOIN first_orders USING (date)\n    LEFT JOIN new_users_orders USING (date)\nORDER BY date;\n",
