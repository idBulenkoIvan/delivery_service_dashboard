  "is_favorite": true,
  "query": "WITH daily_revenue AS (\n    SELECT date, SUM(price) as revenue FROM (\n        SELECT user_id, DATE(time) AS date, order_id,\n               unnest(product_ids) AS product_id\n        FROM user_actions \n        JOIN orders using (order_id)\n        ) s1 \n        JOIN products using (product_id)\n        WHERE  order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE  action = 'cancel_order')\n        GROUP BY date\n)\n        \nSELECT date,\n       revenue,\n       SUM(revenue) OVER (ORDER BY date ASC) AS total_revenue,\n       ROUND((revenue - lag(revenue, 1) OVER (ORDER BY date ASC)) * 100.0 / lag(revenue, 1) OVER (ORDER BY date ASC), 2) AS revenue_change\nFROM   daily_revenue\nORDER BY date asc;",
