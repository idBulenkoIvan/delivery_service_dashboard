  "is_favorite": true,
  "query": "WITH daily_couriers AS (\r\n    SELECT date, COUNT(DISTINCT courier_id) AS couriers_cnt FROM (\r\n        SELECT courier_id, MIN(DATE(time)) AS date FROM courier_actions\r\n        GROUP BY courier_id\r\n    ) AS subquery\r\n    GROUP BY date\r\n),\r\n\r\nactive_couriers AS (\r\n    SELECT DATE(time) AS date, COUNT(DISTINCT courier_id) AS active_couriers_cnt FROM courier_actions\r\n    WHERE action = 'accept_order' AND order_id IN (\r\n        SELECT order_id FROM courier_actions\r\n        WHERE action = 'deliver_order'\r\n    ) OR action = 'deliver_order'\r\n    GROUP BY date\r\n),\r\n\r\ndaily_users AS (\r\n    SELECT date, COUNT(DISTINCT user_id) AS users_cnt FROM (\r\n        SELECT user_id, MIN(DATE(time)) AS date FROM user_actions\r\n        GROUP BY user_id\r\n    ) AS subquery\r\n    GROUP BY date\r\n),\r\n\r\nactive_users AS (\r\n    SELECT DATE(time) AS date, COUNT(DISTINCT user_id) AS active_users_cnt FROM user_actions\r\n    WHERE order_id NOT IN (\r\n        SELECT order_id FROM user_actions\r\n        WHERE action = 'cancel_order'\r\n    )\r\n    GROUP BY date\r\n)\r\n\r\nSELECT ac.date,\r\n       ROUND(ac.active_couriers_cnt::DECIMAL * 100.0 / SUM(c.couriers_cnt) OVER (ORDER BY date), 2) AS active_couriers_share,\r\n       ROUND(au.active_users_cnt::DECIMAL * 100 / SUM(u.users_cnt) OVER (ORDER BY date), 2) AS paying_users_share\r\nFROM active_couriers ac\r\n    JOIN active_users au USING (date)\r\n    JOIN daily_couriers c USING (date)\r\n    JOIN daily_users u USING (date)\r\nORDER BY ac.date ASC;",
