  "is_favorite": true,
  "query": "WITH daily_revenue AS (\n    SELECT date, SUM(price) AS daily_revenue FROM (\n        SELECT DATE(time) AS date, order_id, UNNEST(product_ids) AS product_id FROM user_actions\n        JOIN orders USING (order_id)\n        WHERE order_id NOT IN (\n            SELECT order_id FROM user_actions\n            WHERE action = 'cancel_order'\n        )\n    ) s1 \n    JOIN products USING (product_id)\n    GROUP BY date\n),\n\ndaily_active_users AS (\n    SELECT DATE(time) AS date, COUNT(DISTINCT user_id) AS daily_active_users FROM user_actions \n    GROUP BY DATE(time)\n),\n\ndaily_active_paying_users AS (\n    SELECT DATE(time) AS date, COUNT(DISTINCT user_id) AS daily_active_paying_users FROM user_actions\n    WHERE order_id NOT IN (\n        SELECT order_id FROM user_actions\n        WHERE action = 'cancel_order'\n    )\n    GROUP BY DATE(time) \n),\n\ndaily_finished_orders AS (\n    SELECT DATE(time) AS date, COUNT(DISTINCT order_id) AS daily_finished_orders FROM user_actions\n    WHERE order_id NOT IN (\n        SELECT order_id FROM user_actions\n        WHERE action = 'cancel_order'\n    )\n    GROUP BY DATE(time)\n)\n\nSELECT date, ROUND(daily_revenue / daily_active_users, 2) AS arpu,\n       ROUND(daily_revenue / daily_active_paying_users, 2) AS arppu,\n       ROUND(daily_revenue / daily_finished_orders, 2) AS aov\nFROM daily_revenue\n    JOIN daily_active_users USING (date)\n    JOIN daily_finished_orders USING (date)\n    JOIN daily_active_paying_users USING (date)\nORDER BY date ASC;\n       ",
