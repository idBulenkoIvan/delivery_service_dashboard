  "is_favorite": true,
  "query": "WITH user_stats AS (\n    SELECT date, COUNT(user_id) AS new_users FROM (\n        SELECT user_id, DATE(MIN(time)) AS date FROM user_actions\n        GROUP BY user_id\n    ) AS subquery\n    GROUP BY date\n    ORDER BY date\n),\n\ncourier_stats AS (\n    SELECT date, COUNT(courier_id) AS new_couriers FROM (\n        SELECT courier_id, DATE(MIN(time)) AS date FROM courier_actions\n        GROUP BY courier_id\n    ) AS subquery\n    GROUP BY date\n    ORDER BY date\n),\n\ndaily_stats AS (\n    SELECT date, u.new_users, c.new_couriers,\n           SUM(u.new_users) OVER (ORDER BY date)::INT AS total_users,\n           SUM(c.new_couriers) OVER (ORDER BY date)::INT AS total_couriers\n    FROM user_stats u \n        JOIN courier_stats c USING (date)\n    ORDER BY date ASC\n)\n\nSELECT date, new_users, new_couriers, total_users, total_couriers,\n       ROUND((new_users - LAG(new_users) OVER (ORDER BY date ASC)) * 100.0 / LAG(new_users) OVER (ORDER BY date ASC), 2) AS new_users_change,\n       ROUND((new_couriers - LAG(new_couriers) OVER (ORDER BY date ASC)) * 100.0 / LAG(new_couriers) OVER (ORDER BY date ASC), 2) AS new_couriers_change,\n       ROUND((total_users - LAG(total_users) OVER (ORDER BY date ASC)) * 100.0 / LAG(total_users) OVER (ORDER BY date ASC), 2) AS total_users_growth,\n       ROUND((total_couriers - LAG(total_couriers) OVER (ORDER BY date ASC)) * 100.0 / LAG(total_couriers) OVER (ORDER BY date ASC), 2) AS total_couriers_growth\nFROM daily_stats;",
